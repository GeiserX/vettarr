TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_GROUP_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

TMDB_API_KEY=

PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

QBITTORRENT_URL=http://localhost:8010
QBITTORRENT_USER=
QBITTORRENT_PASS=

POSTGRES_HOST=vettarr-postgres
POSTGRES_PORT=5432
POSTGRES_USER=vettarr
POSTGRES_PASSWORD=
POSTGRES_DB=vettarr

# An environment-only start is the older setup: it runs, degraded, and says so
# in its log. `vettarr config import-env -o config.yaml` moves it to a file.

# UNIT3D trackers — add as many as needed (TRACKER_1_*, TRACKER_2_*, etc.)
TRACKER_1_NAME=My Tracker
TRACKER_1_URL=https://tracker.example.com
TRACKER_1_COOKIE_PATH=/data/cookies/tracker1.txt
TRACKER_1_USERNAME=
TRACKER_1_PASSWORD=
# Text only a logged-out page carries (default: name="password", the login form)
# TRACKER_1_LOGGED_OUT_MARKER=name="password"

# Auto-approval. Off by default: the service keeps asking for every item until
# this is set to true.
AUTO_APPROVE_ENABLED=false
# Books, audiobooks and comics are off: the catalogues often have no record
# for a post's title. Add them here to turn them on.
AUTO_APPROVE_TYPES=movie,series,magazine
# How many IMDb parental-guide votes a severity needs before it is trusted.
MIN_GUIDE_VOTES=5
# How long an item may wait for that data before it is handed back to you.
AUTO_APPROVE_MAX_WAIT_HOURS=24
# Optional Google Books API key. Keyless requests share one daily quota that
# stays exhausted, so without a key Google Books answers 429.
GOOGLE_BOOKS_API_KEY=

LOG_LEVEL=INFO
WEB_PORT=4850
SESSION_DIR=/data/sessions
